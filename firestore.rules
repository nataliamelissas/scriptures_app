rules_version = '2';

// Deny-all default. Firestore has NO security by default, so this locks the
// database until access is granted explicitly per collection as features are
// added. NEVER replace this with `allow read, write: if true;`.
//
// Example of granting owner-only access once Auth is wired up:
//   match /users/{userId} {
//     allow read, write: if request.auth != null && request.auth.uid == userId;
//   }
//
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
